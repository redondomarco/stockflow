# Copiar a .env y completar. .env no se versiona.

# Django — generar con: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False

# Hosts/IPs por los que se accede al sistema
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.200
# Orígenes del admin de Django (con esquema)
CSRF_TRUSTED_ORIGINS=http://localhost,http://192.168.1.200

# PostgreSQL. Cambiar la contraseña acá NO la cambia en una base ya creada:
#   docker compose exec db psql -U stockflow -c "ALTER USER stockflow PASSWORD '<nueva>';"
# y después actualizar este valor y reiniciar el backend.
POSTGRES_DB=stockflow
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=

# Superusuario inicial: solo se crea si la base no tiene ningún superusuario
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Puerto HTTP publicado por nginx (solo despliegue sin HTTPS, p. ej. red local)
HTTP_PORT=80

# ── Despliegue público con HTTPS (DigitalOcean) ──────────────────────
# Descomentar las líneas siguientes. COMPOSE_FILE hace que todos los comandos
# de docker compose / make incluyan Caddy (HTTPS automático con Let's Encrypt).
# En ese caso ALLOWED_HOSTS y CSRF_TRUSTED_ORIGINS deben usar el dominio:
#   ALLOWED_HOSTS=stockflow.example.com
#   CSRF_TRUSTED_ORIGINS=https://stockflow.example.com
#
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
# HTTPS=True
# DOMAIN=stockflow.example.com
# ACME_EMAIL=admin@example.com
# HSTS en segundos: empezar bajo (300) y pasar a 31536000 cuando todo funcione
# HSTS_MAX_AGE=300
