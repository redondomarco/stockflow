# Copiar a .env y completar. .env no se versiona.

# Django — generar con: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False

# Hosts/IPs por los que se accede al sistema
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.200
# Orígenes del admin de Django (con esquema)
CSRF_TRUSTED_ORIGINS=http://localhost,http://192.168.1.200

# PostgreSQL. Cambiar la contraseña acá NO la cambia en una base ya creada:
#   docker compose exec db psql -U stockflow -c "ALTER USER stockflow PASSWORD '<nueva>';"
# y después actualizar este valor y reiniciar el backend.
POSTGRES_DB=stockflow
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=

# Superusuario inicial: solo se crea si la base no tiene ningún superusuario
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Puerto HTTP publicado por nginx
HTTP_PORT=80
